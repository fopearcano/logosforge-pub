APP_NAME=LOGOSFORGE
ENVIRONMENT=development
DEBUG=true

# SQLite by default; swap for a PostgreSQL DSN when migrating.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/logosforge
DATABASE_URL=sqlite:///./logosforge.db
DATABASE_ECHO=false

# Authentication — replace SECRET_KEY in any non-development deployment.
SECRET_KEY=logosforge-dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local file storage root for attachment uploads. The directory is
# created on demand and gitignored.
# STORAGE_PATH=./storage

# AI integration. Default `dry_run` ships canned, deterministic
# responses so the system runs end-to-end without network access.
#
# AI_PROVIDER=dry_run | openai | openrouter | lm_studio | openai_compatible
# AI_BASE_URL=http://localhost:1234/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_REQUEST_TIMEOUT=60
