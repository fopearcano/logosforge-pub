# Root-level environment for docker-compose. Copy to .env before
# running `docker compose up`.

# --- Postgres ---
POSTGRES_USER=logosforge
POSTGRES_PASSWORD=logosforge
POSTGRES_DB=logosforge
POSTGRES_PORT=5432

# --- Backend ---
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
BACKEND_PORT=8000
# CORS_ORIGINS is a JSON array because pydantic-settings parses
# list[str] env vars as JSON.
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# --- Frontend ---
FRONTEND_PORT=8080
